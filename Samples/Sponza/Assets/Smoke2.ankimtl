<?xml version="1.0" encoding="UTF-8" ?>
<material shadow="0">
	<shaderProgram name="ForwardShadingParticlesGass">
		<mutation>
			<mutator name="ANIMATED_TEXTURE" value="0"/>
			<mutator name="LIGHT" value="1"/>
		</mutation>
	</shaderProgram>

	<inputs>
		<input name="m_diffuseTex" value="Assets/Smoke.ankitex"/>
	</inputs>
</material>

