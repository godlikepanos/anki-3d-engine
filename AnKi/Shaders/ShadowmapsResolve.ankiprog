#pragma anki mutator QUALITY 0 1 2 // No filtering, PCF, PCSS

#pragma anki technique vert pixel comp

#include <AnKi/Shaders/QuadVert.hlsl>
#if ANKI_COMPUTE_SHADER || ANKI_PIXEL_SHADER
#	include <AnKi/Shaders/ClusteredShadingFunctions.hlsl>
#	include <AnKi/Shaders/ImportanceSampling.hlsl>
#	include <AnKi/Shaders/ShadowmapsResolve.hlsl>

ConstantBuffer<GlobalRendererConstants> g_globalConstants : register(b0);

SamplerState g_linearAnyClampSampler : register(s0);
SamplerComparisonState g_linearAnyClampShadowSampler : register(s1);

StructuredBuffer<GpuSceneLight> g_lights : register(t0);
Texture2D<Vec4> g_shadowAtlasTex : register(t1);
StructuredBuffer<Cluster> g_clusters : register(t2);
Texture2D<Vec4> g_depthTex : register(t3);
Texture2D<Vec4> g_normalsTex : register(t4);
Texture2D<Vec4> g_noiseTex : register(t5);
Texture2D<F32> g_dirLightShadowHistoryTex : register(t6);
Texture2D<Vec2> g_adjustedMotionVectorsTex : register(t7);

RWTexture2D<Vec4> g_punctualLightsUav : register(u0);
RWTexture2D<F32> g_dirLightShadowUav : register(u1);

Vec3 computeDebugShadowCascadeColor(U32 cascade)
{
	if(cascade == 0u)
	{
		return Vec3(0.0f, 1.0f, 0.0f);
	}
	else if(cascade == 1u)
	{
		return Vec3(0.0f, 0.0f, 1.0f);
	}
	else if(cascade == 2u)
	{
		return Vec3(0.0f, 1.0f, 1.0f);
	}
	else
	{
		return Vec3(1.0f, 0.0f, 0.0f);
	}
}

void appendShadow(F32 shadow, inout U32 index, inout F32 shadows[kMaxShadowCastersPerFragment])
{
	shadows[index] = shadow;
	index = min(index + 1u, kMaxShadowCastersPerFragment - 1u);
}

#	if ANKI_COMPUTE_SHADER
[numthreads(64, 1, 1)] void main(COMPUTE_ARGS)
#	else
void main(VertOut input, out Vec4 punctualLightsRt : SV_TARGET0, out F32 dirLightShadowRt : SV_TARGET1)
#	endif
{
#	if ANKI_COMPUTE_SHADER
	const UVec2 viewportSize = getDimensions(g_dirLightShadowUav);
	const UVec2 coord = getOptimalDispatchThreadId8x8Amd(svGroupIndex, svGroupId.xy);
	if(any(coord >= viewportSize))
	{
		return;
	}

	const Vec2 uv = (coord + 0.5) / viewportSize;
#	else
	const UVec2 viewportSize = getDimensions(g_depthTex);
	const Vec2 uv = input.m_uv;
	const UVec2 coord = input.m_svPosition;
#	endif

#	if 1
	BlueNoiseRandomGenerator randg = createBlueNoiseRandomGenerator(g_noiseTex, coord, g_globalConstants.m_frame);
	const F32 randFactor = rand(randg);
#	else
	const Vec2 noise2 = spatioTemporalNoise(svDispatchThreadId, g_globalConstants.m_frame);
	const F32 randFactor = noise2.x;
#	endif

	const Vec3 worldNormal = unpackNormalFromGBuffer(TEX(g_normalsTex, coord));

	// World position
	const F32 depth = TEX(g_depthTex, coord).r;
	const Vec2 ndc = uvToNdc(uv);
	const Vec4 worldPos4 = mul(g_globalConstants.m_matrices.m_invertedViewProjectionJitter, Vec4(ndc, depth, 1.0));
	Vec3 worldPos = worldPos4.xyz / worldPos4.w;
	worldPos += worldNormal * 0.025; // Push it a bit away from the surface

	// Dir light
	F32 dirLightShadowFactor = 0.0;
	const DirectionalLight dirLight = g_globalConstants.m_directionalLight;
	if(dirLight.m_active && dirLight.m_shadowCascadeCount)
	{
		const U32 shadowCascadeCount = dirLight.m_shadowCascadeCount;

		const F32 positiveZViewSpace = testPlanePoint(g_globalConstants.m_nearPlaneWSpace.xyz, g_globalConstants.m_nearPlaneWSpace.w, worldPos)
									   + g_globalConstants.m_matrices.m_near;

		const F32 lastCascadeDistance = dirLight.m_shadowCascadeDistances[shadowCascadeCount - 1u];
		if(positiveZViewSpace < lastCascadeDistance)
		{
			F32 cascadeBlendFactor;
			const UVec2 cascadeIndices =
				computeShadowCascadeIndex2(positiveZViewSpace, dirLight.m_shadowCascadeDistances, shadowCascadeCount, cascadeBlendFactor);

#	if QUALITY == 2
			const F32 shadowFactorCascadeA = computeShadowFactorDirLightPcss<F32>(dirLight, cascadeIndices.x, worldPos, g_shadowAtlasTex,
																				  g_linearAnyClampShadowSampler, randFactor, g_linearAnyClampSampler);
#	elif QUALITY == 1
			const F32 shadowFactorCascadeA = computeShadowFactorDirLightPcf<F32>(dirLight, cascadeIndices.x, worldPos, g_shadowAtlasTex,
																				 g_linearAnyClampShadowSampler, randFactor);
#	else
			const F32 shadowFactorCascadeA =
				computeShadowFactorDirLight<F32>(dirLight, cascadeIndices.x, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler);
#	endif

			if(cascadeBlendFactor < 0.01 || cascadeIndices.x == cascadeIndices.y)
			{
				// Don't blend cascades
				dirLightShadowFactor = shadowFactorCascadeA;
			}
			else
			{
#	if QUALITY == 2
				// Blend cascades
				const F32 shadowFactorCascadeB = computeShadowFactorDirLightPcss<F32>(
					dirLight, cascadeIndices.y, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler, randFactor, g_linearAnyClampSampler);
#	elif QUALITY == 1
				// Blend cascades
				const F32 shadowFactorCascadeB = computeShadowFactorDirLightPcf<F32>(dirLight, cascadeIndices.y, worldPos, g_shadowAtlasTex,
																					 g_linearAnyClampShadowSampler, randFactor);
#	else
				// Blend cascades
				const F32 shadowFactorCascadeB =
					computeShadowFactorDirLight<F32>(dirLight, cascadeIndices.y, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler);
#	endif
				dirLightShadowFactor = lerp(shadowFactorCascadeA, shadowFactorCascadeB, cascadeBlendFactor);
			}

			F32 distanceFadeFactor = saturate(positiveZViewSpace / lastCascadeDistance);
			distanceFadeFactor = pow(distanceFadeFactor, 8.0);
			dirLightShadowFactor += distanceFadeFactor;
		}
		else
		{
			dirLightShadowFactor = 1.0;
		}

		dirLightShadowFactor = saturate(dirLightShadowFactor);

		// Blend with history
#	if QUALITY > 0
		const Vec2 mv = TEX(g_adjustedMotionVectorsTex, coord);
		const Bool disocclusion = all(mv == 1.0);
		if(!disocclusion)
		{
			const Vec2 historyUv = uv + mv;

			const F32 history = g_dirLightShadowHistoryTex.SampleLevel(g_linearAnyClampSampler, historyUv, 0.0);

			constexpr F32 kDirLightShadowHistoryBlendFactor = 0.2;
			dirLightShadowFactor = lerp(history, dirLightShadowFactor, kDirLightShadowHistoryBlendFactor);
		}
#	endif
	}

#	if ANKI_COMPUTE_SHADER
	TEX(g_dirLightShadowUav, coord) = dirLightShadowFactor;
#	else
	dirLightShadowRt = dirLightShadowFactor;
#	endif

	// Punctual lights
	Cluster cluster = getClusterFragCoord(g_clusters, g_globalConstants.m_clusterer, coord, depth);

	U32 shadowLayer = 0u;
	F32 shadowLayers[kMaxShadowCastersPerFragment] = (F32[kMaxShadowCastersPerFragment])0.0;
	U32 idx = 0;
	[loop] while((idx = iterateLights(cluster)) != kMaxU32)
	{
		const GpuSceneLight light = g_lights[idx];

		[branch] if(light.m_shadow)
		{
			const Vec3 frag2Light = light.m_position - worldPos;

			F32 shadowFactor;
			if(light.m_isPointLight)
			{
#	if QUALITY > 0
				shadowFactor = computeShadowFactorPointLightPcf(light, frag2Light, g_shadowAtlasTex, g_linearAnyClampShadowSampler, randFactor);
#	else
				shadowFactor = computeShadowFactorPointLight<F32>(light, frag2Light, g_shadowAtlasTex, g_linearAnyClampShadowSampler);
#	endif
			}
			else
			{
#	if QUALITY == 2
				shadowFactor = computeShadowFactorSpotLightPcss<F32>(light, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler, randFactor,
																	 g_linearAnyClampSampler);
#	elif QUALITY == 1
				shadowFactor = computeShadowFactorSpotLightPcf<F32>(light, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler, randFactor);
#	else
				shadowFactor = computeShadowFactorSpotLight<F32>(light, worldPos, g_shadowAtlasTex, g_linearAnyClampShadowSampler);
#	endif
			}

			appendShadow(shadowFactor, shadowLayer, shadowLayers);
		}
	}

#	if ANKI_COMPUTE_SHADER
	TEX(g_punctualLightsUav, coord) = packShadowLayers(shadowLayers);
#	else
	punctualLightsRt = packShadowLayers(shadowLayers);
#	endif
}
#endif // ANKI_COMPUTE_SHADER || ANKI_PIXEL_SHADER
