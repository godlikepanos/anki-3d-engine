#include <AnKi/Shaders/ReSTIR.hlsl>
#include <AnKi/Shaders/Include/MiscRendererTypes.h>
#include <AnKi/Shaders/PackFunctions.hlsl>
#include <AnKi/Shaders/Functions.hlsl>
#include <AnKi/Shaders/ClusteredShadingFunctions.hlsl>
#include <AnKi/Shaders/LightFunctions.hlsl>
#include <AnKi/Shaders/BilateralFilter.hlsl>

#pragma anki technique GroundTruth comp
#pragma anki technique Phase1 comp
#pragma anki technique Phase2 comp

constexpr F32 kDirLightMaxRayT = 1000.0; // TODO
constexpr F32 kRayBias = 0.01; // Bias to apply to various ray tracing operations

ConstantBuffer<GlobalRendererConstants> g_globalConsts : register(b0);

StructuredBuffer<GpuSceneLight> g_gpuSceneLights : register(t0);
StructuredBuffer<GpuSceneLight> g_clustererLights : register(t1);
StructuredBuffer<Cluster> g_clusters : register(t2);

RaytracingAccelerationStructure g_tlas : register(t3);

Texture2D<Vec4> g_gbuffer0Tex : register(t4);
Texture2D<Vec4> g_gbuffer1Tex : register(t5);
Texture2D<Vec4> g_gbuffer2Tex : register(t6);
Texture2D g_depthTex : register(t7);

struct DISample
{
	U32 m_gpuSceneArrayIndex; // Index in the GPU scene or kMaxU32 if it's the sun
	Vec3 m_pointOnLight; // For punctual lights it's relative to light position. If it's the sun it's the l direction
};

using DIReservoir = Reservoir<DISample>;

constexpr U32 kDISunLightIndex = 0xFFFFu; // The 16bit form of the kMaxU32 the sun stores in DISample::m_gpuSceneArrayIndex

// m_weightSum is not stored. It's only meaningful while the reservoir is being built. Everything that reads a stored reservoir goes through
// combineReservoirs() which only touches m_weight and m_sampleCount
UVec3 packReservoir(DIReservoir r, Bool extraBool)
{
	UVec3 o;
	o.x = (asuint(f32tof16(r.m_sample.m_pointOnLight.x)) << 16u) | asuint(f32tof16(r.m_sample.m_pointOnLight.y));
	o.y = (r.m_sample.m_gpuSceneArrayIndex << 16u) | asuint(f32tof16(r.m_sample.m_pointOnLight.z));

	const F32 weight = clamp(r.m_weight, 0.0, F32(kMaxF16)); // Can't leave it unbounded or negative (because of the packing bellow)

	// M gets 16 bits. Phase 2 sums the neighbours' M so it can pass that. Saturating loses nothing because Phase 1's temporal clamp discards
	// anything above 20x the fresh candidate count when it reads this back
	const F32 sampleCount = min(r.m_sampleCount, 65535.0);

	o.z = (U32(sampleCount) << 16u) | (asuint(f32tof16(weight)) << 1u) | (!!extraBool);

	return o;
}

DIReservoir unpackReservoir(UVec3 p, out Bool extraBool)
{
	const U32 lightIdx = p.y >> 16u;

	DIReservoir r;
	r.m_sample.m_gpuSceneArrayIndex = (lightIdx == kDISunLightIndex) ? kMaxU32 : lightIdx;
	r.m_sample.m_pointOnLight = Vec3(f16tof32(p.x >> 16u), f16tof32(p.x & 0xFFFFu), f16tof32(p.y & 0xFFFFu));
	r.m_weightSum = 0.0; // Not stored. See packReservoir
	r.m_sampleCount = F32(p.z >> 16u);
	r.m_weight = f16tof32((p.z & 0xFFFFu) >> 1u);
	extraBool = p.z & 1u;

	if(lightIdx == kDISunLightIndex)
	{
		// Normalize the direction
		r.m_sample.m_pointOnLight = normalize(r.m_sample.m_pointOnLight);
	}

	return r;
}

DIReservoir unpackReservoir(UVec3 p)
{
	Bool unused;
	return unpackReservoir(p, unused);
}

Bool isSameSample(DIReservoir a, DIReservoir b)
{
	return a.m_sample.m_gpuSceneArrayIndex == b.m_sample.m_gpuSceneArrayIndex && all(a.m_sample.m_pointOnLight == b.m_sample.m_pointOnLight);
}

// Computes the visibility term
F32 visibility(Vec3 rayOrigin, Vec3 rayDir, F32 tMax)
{
	RayDesc ray;
	ray.Origin = rayOrigin;
	ray.TMin = kRayBias;
	ray.Direction = rayDir;
	ray.TMax = tMax;

	const U32 cullMask = 0xFFu;
	constexpr U32 traceFlags = RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH;

	RayQuery<RAY_FLAG_NONE> q;
	q.TraceRayInline(g_tlas, traceFlags, cullMask, ray);

	while(q.Proceed())
	{
	}
	const Bool hit = q.CommittedStatus() == COMMITTED_TRIANGLE_HIT;

	return (hit) ? 0.0 : 1.0;
}

F32 computePHat(GpuSceneLight light, GbufferInfo<F32> gbuffer, Vec3 surfacePosW, Vec3 pointOnLight)
{
	const Vec3 frag2Light = pointOnLight - surfacePosW;
	const Vec3 l = normalize(frag2Light);

	const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - surfacePosW);
	const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
	const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
	const Vec3 brdf = specC + diffC;

	const F32 att = computeAttenuationFactor(light.m_influenceRadius, light.m_sourceRadius, light.m_position - surfacePosW);
	const F32 lambert = max(0.0, dot(gbuffer.m_normal, l));
	const F32 geom = att * lambert;

	const F32 spot = (light.m_isSpotLight) ? computeSpotFactor(l, light.m_outerCos, light.m_innerCos, light.m_direction) : 1.0;
	const Vec3 I = light.m_luminousIntensity * spot;

	const Vec3 LoNoVis = brdf * I * geom * kPreExposure;

	return computeLuminance(LoNoVis);
}

F32 computePHat(DirectionalLight dirLight, GbufferInfo<F32> gbuffer, Vec3 surfacePosW, Vec3 l)
{
	const F32 geom = max(0.0, dot(l, gbuffer.m_normal));

	const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - surfacePosW);
	const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
	const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
	const Vec3 brdf = diffC + specC;

	const Vec3 LoNoVis = brdf * dirLight.m_illuminance * kPreExposure * geom;

	return computeLuminance(LoNoVis);
}

F32 computePHat(DIReservoir reservoir, GbufferInfo<F32> gbuffer, Vec3 surfacePosW)
{
	const Bool isDirectional = reservoir.m_sample.m_gpuSceneArrayIndex == kMaxU32;
	Vec3 l;
	Vec3 lightEmission;
	F32 attenuationAndSpot;
	if(isDirectional)
	{
		l = reservoir.m_sample.m_pointOnLight;
		lightEmission = g_globalConsts.m_directionalLight.m_illuminance;
		attenuationAndSpot = 1.0;
	}
	else
	{
		const GpuSceneLight light = SBUFF(g_gpuSceneLights, reservoir.m_sample.m_gpuSceneArrayIndex);

		const Vec3 pointOnLight = reservoir.m_sample.m_pointOnLight + light.m_position;
		const Vec3 frag2Light = pointOnLight - surfacePosW;
		l = normalize(frag2Light);

		const F32 att = computeAttenuationFactor(light.m_influenceRadius, light.m_sourceRadius, light.m_position - surfacePosW);
		const F32 spot = (light.m_isSpotLight) ? computeSpotFactor(l, light.m_outerCos, light.m_innerCos, light.m_direction) : 1.0;
		attenuationAndSpot = att * spot;

		lightEmission = light.m_luminousIntensity;
	}

	const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - surfacePosW);
	const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
	const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
	const Vec3 brdf = diffC + specC;

	const F32 lambert = max(0.0, dot(gbuffer.m_normal, l));

	const Vec3 LoNoVis = brdf * lightEmission * (kPreExposure * lambert * attenuationAndSpot);

	return computeLuminance(LoNoVis);
}

// ===========================================================================
// Ground Truth                                                              =
// ===========================================================================
#if ANKI_TECHNIQUE_GroundTruth

RWTexture2D<Vec4> g_uav : register(u0);

Vec3 directLighting(UVec2 coord)
{
	const F32 depth = TEX(g_depthTex, coord).r;

	if(depth == 1.0)
	{
		return 0.0;
	}

	const Vec2 viewportSize = getDimensions(g_uav);
	const Vec2 ndc = uvToNdc((coord + 0.5) / viewportSize);

	const Vec4 worldPos4 = mul(g_globalConsts.m_matrices.m_invertedViewProjectionJitter, Vec4(ndc, depth, 1.0));
	const Vec3 worldPos = worldPos4.xyz / worldPos4.w;

	const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - worldPos);

	RandomGenerator randGen = createRandomGenerator(coord, g_globalConsts.m_frame);

	// Decode GBuffer
	GbufferInfo<F32> gbuffer = (GbufferInfo<F32>)0;
	unpackGBufferNoVelocity<F32>(TEX(g_gbuffer0Tex, coord), TEX(g_gbuffer1Tex, coord), TEX(g_gbuffer2Tex, coord), gbuffer);
	gbuffer.m_subsurface = max(gbuffer.m_subsurface, kSubsurfaceMin);

	const Vec3 biasedPosW = worldPos + viewDir * kRayBias;

	Vec3 Lo = gbuffer.m_emission; // Outgoing radiance (to the eye)

	// Dir light
	const DirectionalLight dirLight = g_globalConsts.m_directionalLight;
	if(dirLight.m_active)
	{
		const F32 thetaMax = toRad(0.266); // This is a typical angle of a cone that has its apex at the worldPos and its tail the sun sphere
		const F32 cosThetaMax = cos(thetaMax);

		const Mat3 coneToWorld = rotationFromDirection(-dirLight.m_direction);

		const F32 cosTheta = lerp(cosThetaMax, 1.0, rand(randGen));
		const F32 sinTheta = sqrt(max(0.0, 1.0 - square(cosTheta)));
		const F32 phi = k2Pi * rand(randGen);

		const Vec3 l = mul(coneToWorld, Vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));

		const F32 geom = max(0.0, dot(l, gbuffer.m_normal));

		if(geom > kEpsilonF32)
		{
			const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
			const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
			const Vec3 brdf = diffC + specC;

			const F32 vis = visibility(biasedPosW, l, kDirLightMaxRayT);

			Lo += brdf * dirLight.m_illuminance * kPreExposure * (geom * vis);
		}
	}

	// Punctual lights
	const U32 lightCount = getStructuredBufferElementCount(g_gpuSceneLights);
	for(U32 i = 0; i < lightCount; ++i)
	{
		// A hack const for now
		constexpr U32 kSampleCount = 1u;

		const GpuSceneLight light = SBUFF(g_gpuSceneLights, i);
		const F32 sourceRadius = light.m_sourceRadius;

		const Vec3 frag2Light = light.m_position - worldPos;
		const F32 distToCenter = length(frag2Light);
		if(distToCenter <= sourceRadius)
		{
			// Inside the sphere, the cone is undefined
			continue;
		}

		const Vec3 dirToCenter = frag2Light / distToCenter;

		const F32 sinThetaMax = sourceRadius / distToCenter;
		const F32 cosThetaMax = sqrt(max(0.0, 1.0 - square(sinThetaMax)));
		const F32 invPdf = k2Pi * (1.0 - cosThetaMax); // Solid angle

		// Bail before tracing anything. Freed light slots are nullified with a position of kSomeFarDistance so their solid angle is zero but they'd
		// still cost kSampleCount scene-long rays per pixel
		if(invPdf <= kEpsilonF32 || all(light.m_luminousIntensity <= 0.0))
		{
			continue;
		}

		// Luminous intensity I is in cd, aka lm/sr. Luminance Le is in nits, aka lm/(sr*m^2). In other words Le=I/area. The area in this case is not
		// the area of the sphere of the light but the one projected to the viewer. The viewer sees a disk which has area of π*r^2. Thus:
		const Vec3 Le = light.m_luminousIntensity * kPreExposure / (kPi * square(sourceRadius));

		const Mat3 coneToWorld = rotationFromDirection(dirToCenter);

		Vec3 sum = 0.0;
		for(U32 s = 0; s < kSampleCount; ++s)
		{
			// Uniform direction inside the cone
			const F32 cosTheta = lerp(cosThetaMax, 1.0, rand(randGen));
			const F32 sinTheta = sqrt(max(0.0, 1.0 - square(cosTheta)));
			const F32 phi = k2Pi * rand(randGen);
			const Vec3 l = mul(coneToWorld, Vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));

			const F32 geom = dot(l, gbuffer.m_normal);
			if(geom < kEpsilonF32)
			{
				continue;
			}

			const F32 spot = (light.m_isSpotLight) ? computeSpotFactor(l, light.m_outerCos, light.m_innerCos, light.m_direction) : 1.0;
			if(spot <= kEpsilonF32)
			{
				continue;
			}

			const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
			const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
			const Vec3 brdf = diffC + specC;

			// Compute a tMax that pushes the ray on the edge of the sphere of light
			const F32 ct = dot(l, dirToCenter);
			const F32 tMax = distToCenter * ct - sqrt(max(0.0, square(sourceRadius) - square(distToCenter) * (1.0 - square(ct))));
			const F32 vis = visibility(biasedPosW, l, tMax);

			sum += brdf * Le * (geom * vis * spot);
		}

		Lo += sum * invPdf / F32(kSampleCount);
	}

	return Lo;
}

[numthreads(64, 1, 1)] void main(COMPUTE_ARGS)
{
	const UVec2 coord = getOptimalDispatchThreadId8x8Amd(svGroupIndex, svGroupId.xy);
	const UVec2 viewportSize = getDimensions(g_uav);

	if(all(coord < viewportSize))
	{
		TEX(g_uav, coord) = Vec4(directLighting(coord), 0.0);
	}
}
#endif

// ===========================================================================
// Phase 1                                                                   =
// ===========================================================================
#if ANKI_TECHNIQUE_Phase1

Texture2D<Vec2> g_adjustedMotionVectorsTex : register(t8);
Texture2D<UVec4> g_prevReservoirsTex : register(t9);

RWTexture2D<UVec4> g_reservoirsUav : register(u0);

// Implements algorithm 3 lines 3 - 9. One candidate per light, so no selection probability. The cone jitter only softens the shadow ray, so a
// light's contribution is the average over its cone and that average's 1/solidAngle cancels the direction pdf's. Leaves a candidate density of 1
DIReservoir RIS(Cluster cluster, Vec3 surfacePosW, GbufferInfo<F32> gbuffer, inout RandomGenerator randg, out F32 selectedSamplePHat)
{
	DIReservoir reservoir = (DIReservoir)0;
	selectedSamplePHat = 0.0;

	// Do the sun
	const DirectionalLight dirLight = g_globalConsts.m_directionalLight;
	if(dirLight.m_active)
	{
		const F32 thetaMax = toRad(0.266); // This is a typical angle of a cone that has its apex at the surfacePosW and its tail the sun sphere
		const F32 cosThetaMax = cos(thetaMax);

		const Mat3 coneToWorld = rotationFromDirection(-dirLight.m_direction);

		const F32 cosTheta = lerp(cosThetaMax, 1.0, rand(randg));
		const F32 sinTheta = sqrt(max(0.0, 1.0 - square(cosTheta)));
		const F32 phi = k2Pi * rand(randg);

		const Vec3 l = mul(coneToWorld, Vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));

		const F32 pHat = computePHat(dirLight, gbuffer, surfacePosW, l);

		const F32 pdf = 1.0; // No random light selection, so no selection probability.
		const F32 risWeight = pHat / pdf;
		const DISample s = {kMaxU32, l};
		if(updateReservoir(reservoir, s, risWeight, randg))
		{
			selectedSamplePHat = pHat;
		}
	}

	// Do punctual lights
	U32 idx;
	[loop] while((idx = iterateLights(cluster)) != kMaxU32)
	{
		const GpuSceneLight light = SBUFF(g_clustererLights, idx);

		const Vec3 frag2Light = light.m_position - surfacePosW;
		const F32 distToCenter = length(frag2Light);
		const Vec3 dirToCenter = frag2Light / distToCenter;

		const F32 sinThetaMax = light.m_sourceRadius / distToCenter;
		const F32 cosThetaMax = sqrt(max(0.0, 1.0 - square(sinThetaMax)));

		const Mat3 coneToWorld = rotationFromDirection(dirToCenter);

		const F32 cosTheta = lerp(cosThetaMax, 1.0, rand(randg));
		const F32 sinTheta = sqrt(max(0.0, 1.0 - square(cosTheta)));
		const F32 phi = k2Pi * rand(randg);
		const Vec3 l = mul(coneToWorld, Vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));

		// Compute a tMax that pushes the ray on the edge of the sphere of light
		const F32 ct = dot(l, dirToCenter);
		const F32 tMax = distToCenter * ct - sqrt(max(0.0, square(light.m_sourceRadius) - square(distToCenter) * (1.0 - square(ct))));

		const Vec3 pointOnLight = surfacePosW + l * tMax;
		const F32 pHat = computePHat(light, gbuffer, surfacePosW, pointOnLight);

		const F32 pdf = 1.0; // No random light selection, so no selection probability.
		const F32 risWeight = pHat / pdf;

		const DISample s = {light.m_gpuSceneArrayIndex, pointOnLight - light.m_position};
		if(updateReservoir(reservoir, s, risWeight, randg))
		{
			selectedSamplePHat = pHat;
		}
	}

	// Line 8
	// The MIS weight is 1 and not 1/M because each candidate is sampled on its own light, so no other candidate could have produced this sample
	finalizeReservoir(reservoir, selectedSamplePHat, 1.0);

	return reservoir;
}

// Implements algorithm 5 lines 4 - 14
[numthreads(64, 1, 1)] void main(COMPUTE_ARGS)
{
	const UVec2 coord = getOptimalDispatchThreadId8x8Amd(svGroupIndex, svGroupId.xy);
	const UVec2 viewportSize = getDimensions(g_reservoirsUav);

	if(any(coord >= viewportSize))
	{
		return;
	}

	F32 phat = 0.0;
	DIReservoir r;
	RandomGenerator randg = createRandomGenerator(coord, g_globalConsts.m_frame);

	// Lines 4 - 5
	const F32 depth = TEX(g_depthTex, coord);
	Vec3 surfacePosW = 0.0;
	GbufferInfo<F32> gbuffer = (GbufferInfo<F32>)0;
	if(depth == 1.0)
	{
		r = (DIReservoir)0;
	}
	else
	{
		const Vec2 uv = (coord + 0.5) / viewportSize;
		const Vec2 ndc = uvToNdc(uv);
		const Vec4 surfacePosW4 = mul(g_globalConsts.m_matrices.m_invertedViewProjectionJitter, Vec4(ndc, depth, 1.0));
		surfacePosW = surfacePosW4.xyz / surfacePosW4.w;

		const Cluster cluster = getClusterFragCoord(g_clusters, g_globalConsts.m_clusterer, coord, depth);

		unpackGBufferNoVelocity<F32>(TEX(g_gbuffer0Tex, coord), TEX(g_gbuffer1Tex, coord), TEX(g_gbuffer2Tex, coord), gbuffer);
		gbuffer.m_subsurface = max(gbuffer.m_subsurface, kSubsurfaceMin);

		r = RIS(cluster, surfacePosW, gbuffer, randg, phat);
	}

	// Visibility of initial candidates. Lines 7 - 9
	F32 vis = 0.0;
	if(r.m_weight > kEpsilonF32)
	{
		const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - surfacePosW);
		const Vec3 biasedSurfacePosW = surfacePosW + viewDir * kRayBias;
		const Bool isDirectional = r.m_sample.m_gpuSceneArrayIndex == kMaxU32;
		F32 rayT;
		Vec3 rayDir;
		if(isDirectional)
		{
			rayT = kDirLightMaxRayT;
			rayDir = r.m_sample.m_pointOnLight;
		}
		else
		{
			const GpuSceneLight light = SBUFF(g_gpuSceneLights, r.m_sample.m_gpuSceneArrayIndex);
			const Vec3 surfaceToHitPoint = (r.m_sample.m_pointOnLight + light.m_position) - biasedSurfacePosW;
			rayT = length(surfaceToHitPoint);
			rayDir = surfaceToHitPoint / rayT;
		}

		vis = visibility(biasedSurfacePosW, rayDir, rayT);
		r.m_weight *= vis;
	}

	// Temporal re-use. Lines 12 - 14
	const DIReservoir initialReservoir = r;
	const Vec2 mv = TEX(g_adjustedMotionVectorsTex, coord);
	const Bool disocclusion = all(mv == 1.0);
	if(!disocclusion)
	{
		const Vec2 uv = (coord + 0.5) / viewportSize;
		const Vec2 historyUv = uv + mv;
		const UVec2 historyCoord = clamp(historyUv * viewportSize, 0.0, viewportSize - 1.0);
		DIReservoir prevReservoir = unpackReservoir(TEX(g_prevReservoirsTex, historyCoord));

		// Clamp the history's M to 20x the current frame's, like the paper does. The history's resampling weight is pHat * W * M, so an unbounded M
		// makes the fresh candidate lose every time and the lighting stops reacting to anything that moves
		prevReservoir.m_sampleCount = min(prevReservoir.m_sampleCount, r.m_sampleCount * 20.0);

		const F32 prevPHat = computePHat(prevReservoir, gbuffer, surfacePosW);

		r = combineReservoirs(r, prevReservoir, phat, prevPHat, phat, randg);
	}

	// Write result
	const Bool isInitialCandidate = isSameSample(r, initialReservoir);
	const Bool visKnown = isInitialCandidate;
	const UVec3 packedReservoir = packReservoir(r, vis != 0.0);
	U32 pHatAndVisibility = asuint(abs(phat));
	pHatAndVisibility |= U32(visKnown) << 31u; // Encode if the visibility is known in the sign bit
	TEX(g_reservoirsUav, coord) = UVec4(packedReservoir, pHatAndVisibility);
}
#endif

// ===========================================================================
// Phase 2                                                                   =
// ===========================================================================
#if ANKI_TECHNIQUE_Phase2

Texture2D<UVec4> g_inReservoirsTex : register(t8);

RWTexture2D<UVec4> g_outReservoirsUav : register(u0);
RWTexture2D<Vec4> g_samplesUav : register(u1);

struct Consts
{
	U32 m_spatialSampleCount;
	F32 m_spatialRadius; // In pixels
	U32 m_padding1;
	U32 m_padding2;
};
ANKI_FAST_CONSTANTS(Consts, g_consts)

// Algorithm 3 lines 10, 11
Vec3 computeSample(GbufferInfo<F32> gbuffer, Vec3 surfacePosW, DIReservoir reservoir, Bool visibilityKnown, F32 visibility_, Vec3 viewDir,
				   Vec3 biasedSurfacePosW)
{
	if(reservoir.m_weight <= kEpsilonF32)
	{
		return 0.0;
	}

	const Bool isDirectional = reservoir.m_sample.m_gpuSceneArrayIndex == kMaxU32;

	// 1st branch
	Vec3 l;
	Vec3 emission; // Intensity (cd) for punctual lights, illuminance (lux) for the sun
	F32 atten;
	F32 rayT;
	if(isDirectional)
	{
		l = reservoir.m_sample.m_pointOnLight;
		emission = g_globalConsts.m_directionalLight.m_illuminance;
		rayT = kDirLightMaxRayT;
		atten = 1.0;
	}
	else
	{
		const GpuSceneLight light = SBUFF(g_gpuSceneLights, reservoir.m_sample.m_gpuSceneArrayIndex);
		const Vec3 surfToLight = reservoir.m_sample.m_pointOnLight + light.m_position - surfacePosW;
		rayT = length(surfToLight);
		l = surfToLight / rayT;
		emission = light.m_luminousIntensity;
		atten = computeAttenuationFactor(light.m_influenceRadius, light.m_sourceRadius, light.m_position - surfacePosW);
		atten *= (light.m_isSpotLight) ? computeSpotFactor(l, light.m_outerCos, light.m_innerCos, light.m_direction) : 1.0;
	}

	const F32 geom = dot(l, gbuffer.m_normal);

	if(geom * atten <= 0.0)
	{
		return 0.0;
	}

	// Compute vis
	F32 vis;
	if(visibilityKnown)
	{
		vis = visibility_;
	}
	else
	{
		vis = visibility(biasedSurfacePosW, l, rayT);
	}

	// BRDF
	const Vec3 diffC = diffuseLobe(gbuffer.m_diffuse);
	const Vec3 specC = specularIsotropicLobe(gbuffer.m_normal, gbuffer.m_f0, gbuffer.m_roughness, viewDir, l);
	const Vec3 brdf = diffC + specC;

	// Outgoing radiance
	const Vec3 Lo = brdf * emission * (kPreExposure * vis * geom * atten);

	return Lo * reservoir.m_weight;
}

// Implements algorithm 5 lines 16 - 23
Vec3 resampleAndShade(UVec2 coord, UVec2 viewportSize, out DIReservoir r)
{
	r = (DIReservoir)0;

	const F32 depth = TEX(g_depthTex, coord);
	if(depth == 1.0)
	{
		return 0.0;
	}

	GbufferInfo<F32> gbuffer = (GbufferInfo<F32>)0;
	unpackGBufferNoVelocity<F32>(TEX(g_gbuffer0Tex, coord), TEX(g_gbuffer1Tex, coord), TEX(g_gbuffer2Tex, coord), gbuffer);
	gbuffer.m_subsurface = max(gbuffer.m_subsurface, kSubsurfaceMin);

	const Vec2 uv = (coord + 0.5) / viewportSize;
	const Vec2 ndc = uvToNdc(uv);
	const Vec4 worldPos4 = mul(g_globalConsts.m_matrices.m_invertedViewProjectionJitter, Vec4(ndc, depth, 1.0));
	const Vec3 worldPos = worldPos4.xyz / worldPos4.w;
	const Vec3 viewDir = normalize(g_globalConsts.m_cameraPosition - worldPos);
	const Vec3 biasedSurfacePosW = worldPos + viewDir * kRayBias;

	RandomGenerator randg = createRandomGenerator(coord, g_globalConsts.m_frame);

	// Read reservoir so far
	const UVec4 packedReservoirAndPhat = TEX(g_inReservoirsTex, coord);
	const F32 initialPHat = abs(asfloat(packedReservoirAndPhat.w));
	Bool visKnown = !!(packedReservoirAndPhat.w & 0x80000000u);
	Bool bVis;
	const DIReservoir initialReservoir = unpackReservoir(packedReservoirAndPhat.xyz, bVis);

	// Spatial re-use. Lines 16 - 20
	{
		r = initialReservoir;
		F32 pHat = initialPHat;

		// unpackReservoir() doesn't restore w_sum but the spatial loop accumulates onto it. Rebuild it by inverting W = (1/M) * w_sum / pHat
		r.m_weightSum = pHat * r.m_weight * r.m_sampleCount;

		F32 totalSampleCount = r.m_sampleCount;

		const Vec4 unprojParams = g_globalConsts.m_matrices.m_unprojectionParameters;
		const F32 viewZ = unprojParams.z / (unprojParams.w + depth);
		constexpr F32 kSpatialMinNormalCos = cos(toRad(25.0)); // the paper's threshold
		constexpr F32 kSpatialMaxDepthDiff = 0.1; // 10% of the view depth, the paper's threshold

		for(U32 i = 0; i < g_consts.m_spatialSampleCount; ++i)
		{
			// Uniform point in a disk. The sqrt is what keeps it uniform instead of clustered in the middle
			const F32 theta = k2Pi * rand(randg);
			const F32 radius = g_consts.m_spatialRadius * sqrt(rand(randg));
			const IVec2 offset = IVec2(round(Vec2(cos(theta), sin(theta)) * radius));
			const UVec2 neighbourCoord = clamp(IVec2(coord) + offset, 0, IVec2(viewportSize) - 1);

			if(all(coord == neighbourCoord))
			{
				continue;
			}

			const F32 neighbourDepth = TEX(g_depthTex, neighbourCoord);
			const F32 neighbourViewZ = unprojParams.z / (unprojParams.w + neighbourDepth);
			if(abs(neighbourViewZ - viewZ) > abs(viewZ) * kSpatialMaxDepthDiff)
			{
				continue;
			}

			const Vec3 neighbourNormal = unpackNormalFromGBuffer<F32>(TEX(g_gbuffer2Tex, neighbourCoord));
			if(dot(neighbourNormal, gbuffer.m_normal) < kSpatialMinNormalCos)
			{
				continue;
			}

			DIReservoir neighbourReservoir = unpackReservoir(TEX(g_inReservoirsTex, neighbourCoord));
			const F32 neighbourPHat = computePHat(neighbourReservoir, gbuffer, worldPos);

			if(updateReservoir(r, neighbourReservoir.m_sample, neighbourPHat * neighbourReservoir.m_weight * neighbourReservoir.m_sampleCount, randg))
			{
				pHat = neighbourPHat;
			}

			totalSampleCount += neighbourReservoir.m_sampleCount;
		}

		r.m_sampleCount = totalSampleCount;
		finalizeReservoirBiased(r, pHat);

		// Boiling filter from "Wyman & Panteleev, HPG 2021"
		const F32 waveMeanWeight = WaveActiveSum(r.m_weight) / F32(max(1u, WaveActiveCountBits(r.m_weight > 0.0)));
		const F32 threshold = 10.0; // Lower is more aggressive
		if(r.m_weight > waveMeanWeight * threshold)
		{
			r = (DIReservoir)0;
		}
	}

	// Compute pixel color. Line 23
	const Bool isInitialCandidate = isSameSample(r, initialReservoir);
	visKnown = visKnown && isInitialCandidate;
	const Vec3 color = computeSample(gbuffer, worldPos, r, visKnown, bVis, viewDir, biasedSurfacePosW);

	return color + gbuffer.m_emission;
}

[numthreads(64, 1, 1)] void main(COMPUTE_ARGS)
{
	const UVec2 coord = getOptimalDispatchThreadId8x8Amd(svGroupIndex, svGroupId.xy);
	const UVec2 viewportSize = getDimensions(g_inReservoirsTex);

	if(any(coord >= viewportSize))
	{
		return;
	}

	DIReservoir reservoir;
	const Vec3 color = resampleAndShade(coord, viewportSize, reservoir);

	TEX(g_outReservoirsUav, coord) = UVec4(packReservoir(reservoir, false), 0u);
	TEX(g_samplesUav, coord) = Vec4(color, 0.0);
}
#endif
